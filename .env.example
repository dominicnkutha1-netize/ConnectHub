# ConnectHub environment variables
#
# Copy to .env for local Docker runs:   cp .env.example .env
# On Render/Fly/Railway, set these in the dashboard instead — never commit .env.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Signing key for JWTs. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value logs every user out.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Comma-separated allowlist, e.g. https://connecthub.example.com,http://localhost:3000
# Use * only for local development.
CORS_ORIGINS=*

# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Set to false if the app is directly exposed with no reverse proxy in front.
TRUST_PROXY=true

# How long a session lasts (jsonwebtoken duration string).
JWT_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where the JSON data file and uploads live. In Docker these are volumes.
DATA_DIR=./server/data
UPLOADS_DIR=./server/uploads
MAX_UPLOAD_BYTES=5242880
BODY_LIMIT=100kb

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Set to "off" to disable (not recommended in production).
RATE_LIMIT=on
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000
API_RATE_MAX=300
API_RATE_WINDOW_MS=60000
